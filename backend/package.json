{
  "name": "fitcoach-pro-backend",
  "version": "0.1.0",
  "description": "FitCoach Pro backend — Express + TypeScript + MongoDB/Mongoose REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "dev:watch:build": "tsc -w -p tsconfig.json",
    "dev:watch:serve": "node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsc -p tsconfig.json && node dist/seed/seed.js"
  },
  "keywords": [
    "fitcoach",
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
