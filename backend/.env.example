# Copy this file to .env and adjust values for your machine.
# Do NOT put real secrets in this example file.

# Server
PORT=4000
NODE_ENV=development

# Database
# NOTE: MongoDB's default port is 27017, but this project's local setup runs on
# 27018. Match whatever your local mongod listens on.
MONGO_URI=mongodb://127.0.0.1:27018/fitcoach_pro

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — allowed frontend origin.
# The backend reads CORS_ORIGIN (see src/config/env.ts).
CORS_ORIGIN=http://localhost:4200
